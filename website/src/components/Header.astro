---
import StarButton from "./StarButton.astro";
import type { Locale } from "../lib/i18n";
import { copy, repoUrl } from "../lib/i18n";

interface Props {
  locale: Locale;
  stars: string | null;
}

const { locale, stars } = Astro.props;
const t = copy[locale];
const home = locale === "en" ? "/en/" : "/";
const other = locale === "en" ? "/" : "/en/";
const otherLabel = locale === "en" ? "JA" : "EN";
---

<a class="skip" href="#content">{t.skip}</a>
<header class="site-header">
  <a class="wordmark" href={home}>
    <img src="/logo.png" alt="" width="36" height="36" />
    <span>{t.wordmark}</span>
  </a>
  <div class="header-tools">
    <StarButton stars={stars} label={t.starAction} compact />
    <a class="icon-btn" href={repoUrl} rel="noopener noreferrer" target="_blank" aria-label="GitHub">
      <svg width="18" height="18" viewBox="0 0 16 16" aria-hidden="true">
        <path
          fill="currentColor"
          d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"
        ></path>
      </svg>
    </a>
    <a class="icon-btn" href="https://x.com/jammaru_lab" rel="noopener noreferrer" target="_blank" aria-label="X">
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
        <path
          fill="currentColor"
          d="M9.47 6.77 15.3 0h-1.38L8.86 5.88 4.73 0H0l6.11 8.9L0 16h1.38l5.35-6.22L11.27 16H16L9.47 6.77Zm-1.89 2.2-.62-.89L1.88 1.04h2.12l3.98 5.7.62.89 5.17 7.4h-2.12l-4.22-6.06Z"
        ></path>
      </svg>
    </a>
    <button class="theme-btn" type="button" data-theme-toggle aria-label="Theme">
      <span class="theme-track">
        <span class="theme-thumb" aria-hidden="true">
          <svg class="theme-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
          </svg>
          <svg class="theme-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 14.5A8.5 8.5 0 1 1 9.5 3 7 7 0 0 0 21 14.5z"></path>
          </svg>
        </span>
      </span>
    </button>
    <a class="lang-switch" href={other} hrefLang={locale === "en" ? "ja" : "en"}>{otherLabel}</a>
  </div>
</header>

<script>
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  function apply(theme: string) {
    root.dataset.theme = theme;
    toggle?.setAttribute("data-mode", theme);
  }
  apply(root.dataset.theme || "light");
  toggle?.addEventListener("click", () => {
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    localStorage.setItem("theme", next);
    apply(next);
  });
</script>
