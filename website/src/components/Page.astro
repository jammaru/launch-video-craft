---
import "@fontsource/outfit/latin-700.css";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/ibm-plex-mono/latin-600.css";
import "../styles/global.css";
import Header from "./Header.astro";
import CommandCopy from "./CommandCopy.astro";
import StarButton from "./StarButton.astro";
import { copy, installCommand, repoUrl, type Locale } from "../lib/i18n";
import { formatStars, getGithubStars } from "../lib/github";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
const stars = formatStars(await getGithubStars());
const canonical = locale === "en" ? "https://launch.jammaru.com/en/" : "https://launch.jammaru.com/";
const icons = [
  `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="14" x="3" y="5" rx="2"/><path d="m3 7 9 6 9-6"/></svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h4l2-3h6l2 3h4v12H3z"/><circle cx="12" cy="13" r="3"/></svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M4 12h10M4 17h7"/></svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13"/><path d="M3 6h.01M3 12h.01M3 18h.01"/></svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>`,
];
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ja" href="https://launch.jammaru.com/" />
    <link rel="alternate" hreflang="en" href="https://launch.jammaru.com/en/" />
    <link rel="alternate" hreflang="x-default" href="https://launch.jammaru.com/" />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === "en" ? "en_US" : "ja_JP"} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <script is:inline>
      (function () {
        var stored = localStorage.getItem("theme");
        var theme =
          stored === "dark" || stored === "light"
            ? stored
            : matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <Header locale={locale} stars={stars} />
    <main id="content" class="shell">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="kicker">{t.kicker}</p>
          <h1 id="hero-title">{t.heroTitle}</h1>
          <p class="lead">{t.heroLead}</p>
          <p class="install-label">{t.installLabel}</p>
          <CommandCopy
            label={t.installLabel}
            showTabs={false}
            tabs={[{ id: "install", label: t.installLabel, command: installCommand }]}
          />
          <p class="install-note">{t.installNote}</p>
          <div class="actions">
            <a class="btn btn-ghost" href={repoUrl} rel="noopener noreferrer" target="_blank">{t.github}</a>
            <a class="btn btn-ghost" href="https://skills.sh/jammaru/launch-video-craft" rel="noopener noreferrer" target="_blank">skills.sh</a>
          </div>
        </div>
        <div class="hero-visual" aria-hidden="true">
          <div class="logo-panel">
            <img src="/logo.png" alt="" width="320" height="320" />
          </div>
        </div>
      </section>

      <section class="section" aria-labelledby="what-title">
        <h2 id="what-title">{t.whatTitle}</h2>
        <p class="section-lead">{t.whatLead}</p>
        <div class="bento">
          {
            t.features.map((feature, index) => (
              <article class:list={["tile", index < 2 ? "span-3" : "span-2"]}>
                <div class="icon" set:html={icons[index]} />
                <h3>{feature.title}</h3>
                <p>{feature.body}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="section" aria-labelledby="films-title">
        <h2 id="films-title">{t.filmsTitle}</h2>
        <p class="section-lead">{t.filmsLead}</p>
        <div class="films">
          {
            t.films.map((film) => (
              <figure class="film">
                <video controls playsinline preload="metadata" poster={film.poster}>
                  <source src={film.src} type="video/mp4" />
                </video>
                <figcaption>
                  <h3>{film.title}</h3>
                  <p>{film.body}</p>
                  {"href" in film && film.href && (
                    <a href={film.href} rel="noopener noreferrer" target="_blank">
                      {film.hrefLabel}
                    </a>
                  )}
                </figcaption>
              </figure>
            ))
          }
        </div>
      </section>

      <section class="section" aria-labelledby="ask-title">
        <h2 id="ask-title">{t.askTitle}</h2>
        <p class="section-lead">{t.askLead}</p>
        <CommandCopy
          label={t.askLabel}
          shell={false}
          showTabs={false}
          tabs={[{ id: "ask", label: t.askLabel, command: t.askCommand }]}
        />
      </section>

      <section class="section" aria-labelledby="more-title">
        <h2 id="more-title">{t.moreTitle}</h2>
        <p class="section-lead">{t.moreLead}</p>
        <CommandCopy label={t.moreTitle} tabs={t.moreTabs.map((tab) => ({ ...tab }))} />
      </section>

      <section class="star-section" aria-labelledby="star-title">
        <p id="star-title" class="star-hand">{t.starLine}</p>
        <svg class="star-arrow" viewBox="0 0 120 48" aria-hidden="true">
          <path d="M10 8 C 40 4, 70 10, 95 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          <path d="M86 22 L97 30 L84 34" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <div class="star-row">
          <a class="star-repo" href={repoUrl} rel="noopener noreferrer" target="_blank">
            <svg width="18" height="18" viewBox="0 0 16 16" aria-hidden="true">
              <path
                fill="currentColor"
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"
              ></path>
            </svg>
            <span>{repoUrl}</span>
          </a>
          <StarButton stars={stars} label={t.starAction} />
        </div>
      </section>

      <footer class="site-footer">
        <p>
          <a href="https://x.com/jammaru_lab" rel="noopener noreferrer" target="_blank">{t.copyright}</a>
        </p>
      </footer>
    </main>
  </body>
</html>
